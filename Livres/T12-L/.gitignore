# ---------------------------------------------------------------------------
#  Dépôt du livre : on ne versionne que les sources.
#  Tout ce qui se régénère par une compilation reste hors du dépôt.
# ---------------------------------------------------------------------------

# Dossier de compilation
build/

# Sorties PDF, où qu'elles se trouvent
*.pdf
!figures/**/*.pdf          # sauf une figure fournie telle quelle

# Fichiers auxiliaires LaTeX
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.nav
*.snm
*.vrb
*.bbl
*.blg
*.bcf
*.run.xml
*.idx
*.ilg
*.ind
*.glo
*.gls
*.xdv
*.dvi
*.ps

# latexmk
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)

# tcolorbox, minted, TikZ externalisation
*.listing
_minted*/
*.pgf-plot.*
tikz-cache/

# Éditeurs et systèmes
.DS_Store
Thumbs.db
*~
*.swp
.vscode/
.idea/
