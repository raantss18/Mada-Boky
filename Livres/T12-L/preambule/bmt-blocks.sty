% ---------------------------------------------------------------------------
%  bmt-blocks.sty — les blocs pédagogiques du livre
%  Chaque bloc porte un titre parlé, adressé à l'élève, jamais une étiquette neutre.
%  Reprend le langage visuel des livres Terminale S et Terminale OSE, avec
%  trois blocs de plus, propres au livre L : le QCM, le vrai ou faux et le
%  devoir surveillé calibré sur l'épreuve réelle (2 h 15).
% ---------------------------------------------------------------------------
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bmt-blocks}[2026/09/10 Blocs pedagogiques du livre T12-L]

\RequirePackage{tcolorbox}
\tcbuselibrary{skins, breakable, most}
\RequirePackage{environ}
\RequirePackage{amsmath, amsthm}

% --- Bascule professeur / élève --------------------------------------------
% Compiler avec :  ./compiler.sh prof   (voir compiler.sh)
\newif\ifbmtprof
\ifdefined\editionprof \bmtproftrue \else \bmtproffalse \fi

% ---------------------------------------------------------------------------
%  1. Gabarit commun : filet coloré à gauche, titre en capitales douces
% ---------------------------------------------------------------------------
\tcbset{
  bmtbase/.style = {
    enhanced, breakable, sharp corners,
    boxrule = 0pt, leftrule = 2.2pt,
    colframe = bmtAccent, colback = bmtPapier,
    left = 10pt, right = 6pt, top = 7pt, bottom = 7pt,
    boxsep = 0pt,
    fonttitle = \sffamily\bfseries\footnotesize,
    coltitle = bmtAccent,
    colbacktitle = bmtPapier,
    titlerule = 0pt,
    toptitle = 1pt, bottomtitle = 4pt,
    top = 4pt,
  },
  bmtplein/.style = {
    bmtbase, colback = bmtAccentPale, colbacktitle = bmtAccentPale,
  },
}

% ---------------------------------------------------------------------------
%  2. Blocs d'entrée de chapitre — uniquement des notions déjà acquises
% ---------------------------------------------------------------------------
\newtcolorbox{revision}[1][]{%
  bmtbase, colframe = bmtGris, colback = bmtGrisClair!35!bmtPapier,
  colbacktitle = bmtGrisClair!35!bmtPapier, coltitle = bmtEncre,
  title = {JE RÉVISE AVANT DE COMMENCER\ifx\relax#1\relax\else\ \textbullet\ #1\fi}}

\newtcolorbox{automatismes}[1][]{%
  bmtbase, colframe = bmtGris, colback = bmtPapier,
  coltitle = bmtEncre,
  title = {TROIS MINUTES D'AUTOMATISMES\ifx\relax#1\relax\else\ \textbullet\ #1\fi}}

% ---------------------------------------------------------------------------
%  3. Le cours
% ---------------------------------------------------------------------------
\newcounter{bmtdef}[chapter]
\renewcommand{\thebmtdef}{\thechapter.\arabic{bmtdef}}

\newtcolorbox[use counter = bmtdef]{definition}[1][]{%
  bmtplein, title = {DÉFINITION~\thebmtdef\ \textbullet\ #1}}

\newcounter{bmtthm}[chapter]
\renewcommand{\thebmtthm}{\thechapter.\arabic{bmtthm}}

\newtcolorbox[use counter = bmtthm]{theoreme}[1][]{%
  bmtbase, colback = bmtPapier, leftrule = 3.5pt,
  title = {THÉORÈME~\thebmtthm\ \textbullet\ #1}}

\newtcolorbox[use counter = bmtthm]{propriete}[1][]{%
  bmtbase, colback = bmtPapier,
  title = {PROPRIÉTÉ~\thebmtthm\ \textbullet\ #1}}

% Démonstration : discrète, encre grise, marque de fin
\newenvironment{demonstration}[1][]{%
  \par\vspace{0.35em}\begingroup
  \small\color{bmtEncre!85}
  \noindent\textsf{\footnotesize\bfseries\color{bmtGris}DÉMONSTRATION\ifx\relax#1\relax\else~— #1\fi}\par\nobreak
  \vspace{0.2em}\noindent\ignorespaces
}{%
  \hfill{\color{bmtAccent}\rule{0.52em}{0.52em}}\endgroup\par\vspace{0.35em}
}

\newtcolorbox{remarque}[1][]{%
  bmtbase, colframe = bmtGris, colback = bmtPapier, leftrule = 1.4pt,
  coltitle = bmtGris,
  title = {REMARQUE\ifx\relax#1\relax\else\ \textbullet\ #1\fi}}

\newtcolorbox{avertissement}[1][]{%
  bmtbase, colframe = bmtLaterite, colback = bmtLaterite!6!bmtPapier,
  colbacktitle = bmtLaterite!6!bmtPapier, coltitle = bmtLaterite,
  title = {AVERTISSEMENT\ifx\relax#1\relax\else\ \textbullet\ #1\fi}}

% Argument obligatoire : une méthode porte toujours un nom.
\newtcolorbox{methode}[1]{%
  bmtbase, colframe = bmtVetiver, colback = bmtVetiver!6!bmtPapier,
  colbacktitle = bmtVetiver!6!bmtPapier, coltitle = bmtVetiver, title = {COMMENT ON S'Y PREND \textbullet\ #1}}

% ---------------------------------------------------------------------------
%  4. Voir et comprendre
% ---------------------------------------------------------------------------
% La légende se lit comme si le professeur commentait la figure au tableau.
\newtcolorbox{visualisation}[1][]{%
  bmtbase, colback = bmtPapier, colframe = bmtAccent, leftrule = 2.2pt,
  title = {JE VISUALISE\ifx\relax#1\relax\else\ \textbullet\ #1\fi}}

\newcounter{bmtex}[chapter]
\renewcommand{\thebmtex}{\thechapter.\arabic{bmtex}}

\newtcolorbox[use counter = bmtex]{exemple}[1][]{%
  bmtbase, colback = bmtPapier, colframe = bmtGris, leftrule = 1.4pt,
  coltitle = bmtEncre,
  title = {JE COMPRENDS SUR UN EXEMPLE~\thebmtex\ifx\relax#1\relax\else\ \textbullet\ #1\fi}}

% ---------------------------------------------------------------------------
%  5. Les exercices
% ---------------------------------------------------------------------------
\newcounter{bmtexo}[chapter]
\renewcommand{\thebmtexo}{\arabic{bmtexo}}

\newcommand{\exo}[1][]{%
  \refstepcounter{bmtexo}%
  \par\vspace{0.55em}\noindent
  {\sffamily\bfseries\small\color{bmtAccent}\thebmtexo}%
  \ifx\relax#1\relax\else\ {\sffamily\small\color{bmtGris}#1}\fi
  \hspace{0.5em}\ignorespaces}

% Niveau de difficulté : trois pastilles
\newcommand{\niveau}[1]{%
  \tikz[baseline=-0.15em]{
    \foreach \i in {1,2,3}{
      \pgfmathparse{\i<=#1 ? 1 : 0}
      \ifnum\pgfmathresult=1
        \fill[bmtAccent] (\i*0.22,0) circle (0.062);
      \else
        \draw[bmtGris, line width=0.35pt] (\i*0.22,0) circle (0.062);
      \fi}}}

\newtcolorbox{entrainement}[1][]{%
  bmtbase, colback = bmtPapier, colframe = bmtAccent,
  title = {JE M'ENTRAÎNE\ifx\relax#1\relax\else\ \textbullet\ #1\fi}}

\newtcolorbox{jecherche}[1][]{%
  bmtbase, colframe = bmtVetiver, colback = bmtVetiver!5!bmtPapier,
  colbacktitle = bmtVetiver!5!bmtPapier, coltitle = bmtVetiver,
  title = {JE CHERCHE\ifx\relax#1\relax\else\ \textbullet\ #1\fi}}

\newtcolorbox{jemeteste}[1][]{%
  bmtbase, colframe = bmtGris, colback = bmtGrisClair!30!bmtPapier,
  colbacktitle = bmtGrisClair!30!bmtPapier, coltitle = bmtEncre,
  title = {JE ME TESTE\ifx\relax#1\relax\else\ \textbullet\ #1\fi}}

\newtcolorbox{commeaubac}[1][]{%
  bmtbase, colframe = bmtLaterite, colback = bmtPapier, leftrule = 3.5pt,
  coltitle = bmtLaterite,
  title = {JE M'ENTRAÎNE COMME AU BACCALAURÉAT\ifx\relax#1\relax\else\ \textbullet\ #1\fi}}

% Aucun sujet de concours (ENI, ESPA) ne convient à la série L : ce bloc
% n'est jamais mobilisé dans ce livre. Il reste défini pour que la collection
% partage un seul et même fichier de blocs.
\newtcolorbox{concours}[1][]{%
  bmtbase, colframe = bmtRaphia, colback = bmtRaphia!6!bmtPapier,
  colbacktitle = bmtRaphia!6!bmtPapier, coltitle = bmtRaphia,
  title = {JE VISE LE CONCOURS\ifx\relax#1\relax\else\ \textbullet\ #1\fi}}

% Les exercices d'annales de fin de chapitre : chacun porte sa provenance.
\newtcolorbox{annales}[1][]{%
  bmtbase, colback = bmtPapier, colframe = bmtAccent, leftrule = 2.2pt,
  title = {JE M'ENTRAÎNE SUR ANNALES\ifx\relax#1\relax\else\ \textbullet\ #1\fi}}

% Un exercice d'annales : numéro, puis provenance en petites capitales grises.
% L'argument optionnel indique la notion d'un chapitre anterieur que
% l'exercice fait egalement travailler.
\RequirePackage{etoolbox}
\newcommand{\exoann}[2][]{%
  \refstepcounter{bmtexo}%
  \par\vspace{0.7em}\noindent
  {\sffamily\bfseries\small\color{bmtAccent}\thebmtexo}\hspace{0.5em}%
  {\sffamily\footnotesize\color{bmtGris}#2}%
  \notblank{#1}{\hspace{0.45em}{\sffamily\footnotesize\itshape
    \color{bmtAccent}(#1)}}{}%
  \par\vspace{0.15em}\noindent\ignorespaces}

% Provenance d'un exercice repris : session et source, en tête de l'énoncé.
\newcommand{\bmtsource}[1]{%
  \par\noindent{\sffamily\footnotesize\color{bmtGris}#1}%
  \par\vspace{0.4em}}

% ---------------------------------------------------------------------------
%  6. Réservé au professeur (édition professeur seulement)
% ---------------------------------------------------------------------------
\NewEnviron{corrige}[1][]{%
  \ifbmtprof
    \begin{tcolorbox}[bmtbase, colframe = bmtVetiver,
        colback = bmtVetiver!5!bmtPapier, colbacktitle = bmtVetiver!5!bmtPapier,
        leftrule = 1.4pt, coltitle = bmtVetiver, fontupper = \small,
        title = {CORRIGÉ\ifx\relax#1\relax\else\ \textbullet\ #1\fi}]
      \BODY
    \end{tcolorbox}
  \fi}

\NewEnviron{notepourlaclasse}{%
  \ifbmtprof
    \begin{tcolorbox}[bmtbase, colframe = bmtRaphia,
        colback = bmtRaphia!7!bmtPapier, colbacktitle = bmtRaphia!7!bmtPapier,
        leftrule = 1.4pt, coltitle = bmtRaphia, fontupper = \small,
        title = {NOTE POUR LA CLASSE}]
      \BODY
    \end{tcolorbox}
  \fi}

% Erreur classique : visible dans les deux éditions, formulée pour l'élève
\newtcolorbox{erreurclassique}[1][]{%
  bmtbase, colframe = bmtLaterite, colback = bmtPapier, leftrule = 1.4pt,
  coltitle = bmtLaterite, fontupper = \small,
  title = {L'ERREUR QUE L'ON VOIT CHAQUE ANNÉE\ifx\relax#1\relax\else\ \textbullet\ #1\fi}}


% ---------------------------------------------------------------------------
%  7. Les formats d'exercices propres au livre L
%     Le programme de la série L tient en deux heures par semaine : la
%     variété des formats y remplace le volume horaire.
% ---------------------------------------------------------------------------

% QCM : une seule réponse exacte par question.
\newtcolorbox{qcm}[1][]{%
  bmtbase, colframe = bmtRaphia, colback = bmtRaphia!5!bmtPapier,
  colbacktitle = bmtRaphia!5!bmtPapier, coltitle = bmtRaphia,
  title = {QCM \textbullet\ UNE SEULE RÉPONSE EXACTE\ifx\relax#1\relax\else\ \textbullet\ #1\fi}}

% Vrai ou faux : la justification fait partie de la réponse.
\newtcolorbox{vraifaux}[1][]{%
  bmtbase, colframe = bmtGris, colback = bmtPapier, leftrule = 1.4pt,
  coltitle = bmtEncre,
  title = {VRAI OU FAUX ? \textbullet\ ON JUSTIFIE EN UNE LIGNE\ifx\relax#1\relax\else\ \textbullet\ #1\fi}}

% Lecture graphique : tout se lit sur la figure, rien ne se calcule.
\newtcolorbox{lecturegraphique}[1][]{%
  bmtbase, colframe = bmtVetiver, colback = bmtPapier, leftrule = 1.4pt,
  coltitle = bmtVetiver,
  title = {JE LIS SUR LE GRAPHIQUE\ifx\relax#1\relax\else\ \textbullet\ #1\fi}}

% Situation concrète : un énoncé enraciné, chiffres plausibles, question utile.
\newtcolorbox{situation}[1][]{%
  bmtbase, colframe = bmtRaphia, colback = bmtPapier, leftrule = 2.2pt,
  coltitle = bmtRaphia,
  title = {UNE SITUATION À TRAITER\ifx\relax#1\relax\else\ \textbullet\ #1\fi}}

% Devoir surveillé : calibré sur l'épreuve réelle de la série L —
% 2 h 15, deux exercices de 5 points et un problème de 10 points, les
% questions supplémentaires réservées à l'option A2 étant signalées.
\newtcolorbox{devoirsurveille}[1][]{%
  bmtbase, colframe = bmtEncre, colback = bmtPapier, leftrule = 3.5pt,
  coltitle = bmtEncre,
  title = {DEVOIR SURVEILLÉ \textbullet\ 2\,h\,15, AU FORMAT DE L'ÉPREUVE\ifx\relax#1\relax\else\ \textbullet\ #1\fi}}

% Barème d'une question, aligné à droite comme sur les sujets officiels.
\newcommand{\bareme}[1]{\hfill\textup{\footnotesize\color{bmtGris}(#1)}}

% Marque d'une question réservée à l'option A2.
\newcommand{\pourAdeux}{%
  \par\vspace{0.35em}\noindent
  {\sffamily\footnotesize\bfseries\color{bmtLaterite}POUR L'OPTION A2 SEULEMENT}%
  \par\vspace{0.15em}}

% Réponse attendue d'un QCM, visible en édition professeur seulement.
\newcommand{\reponseqcm}[1]{\ifbmtprof\ {\color{bmtVetiver}\textbf{[#1]}}\fi}

\endinput
