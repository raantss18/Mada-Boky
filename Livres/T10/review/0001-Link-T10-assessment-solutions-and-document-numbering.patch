 \chapter*{Corrigés de la banque d'exercices et de problèmes}
 \addcontentsline{toc}{chapter}{Corrigés de la banque d'exercices et de problèmes}
 
+% The correction bank follows the 42 exercises and then the 8 problems in
+% evaluations.tex. The saved counters preserve the statement identifiers even
+% though the bank continues the chapter-9 exercise and problem sequences.
+\newcounter{nbanksolution}
+\newcounter{bankexercisebase}
+\setcounter{bankexercisebase}{\value{nexo}}
+\addtocounter{bankexercisebase}{-42}
+\newcounter{bankproblembase}
+\setcounter{bankproblembase}{\value{nprob}}
+\addtocounter{bankproblembase}{-8}
+\let\bankparagraph\paragraph
+\renewcommand{\paragraph}[1]{%
+  \stepcounter{nbanksolution}%
+  \ifnum\value{nbanksolution}<43
+    \bankparagraph{#1\enspace\hyperref[exo:\thechapter.\number\numexpr\value{bankexercisebase}+\value{nbanksolution}\relax]
+      {\textcolor{OR!75}{\small$\uparrow$\,\textit{énoncé}}}}%
+    \label{sol:B\thechapter.\number\numexpr\value{bankexercisebase}+\value{nbanksolution}\relax}%
+  \else
+    \bankparagraph{#1\enspace\hyperref[prob:\thechapter.\number\numexpr\value{bankproblembase}+\value{nbanksolution}-42\relax]
+      {\textcolor{OR!75}{\small$\uparrow$\,\textit{énoncé}}}}%
+    \label{sol:BP\thechapter.\number\numexpr\value{bankproblembase}+\value{nbanksolution}-42\relax}%
+  \fi
+}
+
 \section*{Repère diagnostique}
 
