% Every optional extension is deliberately more conspicuous than ordinary
% pedagogy: red vertical rule, red heading, and pale red background.  The rule
% continues on every page when the box breaks.
\definecolor{HPred}{RGB}{185,28,28}
\newtcolorbox{extensiont10box}[1][]{enhanced,breakable,frame hidden,
  borderline west={5pt}{0pt}{HPred},colback=HPred!3,sharp corners,
  left=14pt,right=9pt,top=7pt,bottom=7pt,
  before upper={{\color{HPred}\small\scshape\bfseries Hors programme T10 -- non exigible\if\relax\detokenize{#1}\relax\else\ -- #1\fi}\par\vspace{3pt}{\color{HPred!35}\rule{\linewidth}{0.45pt}}\par\vspace{4pt}}}
\NewDocumentEnvironment{extensiont10}{O{}}{\begin{extensiont10box}[#1]}{\end{extensiont10box}}
\newcommand{\horsprogramme}[1]{\begin{extensiont10box}[Début d'un approfondissement]\textbf{\color{HPred}Tout le développement signalé ci-après est hors programme T10 : ne pas l'enseigner comme prérequis et ne pas l'évaluer.} #1\end{extensiont10box}}
\DeclareRobustCommand{\ExtensionTTen}{\textcolor{HPred}{\textbf{\scriptsize [HORS PROGRAMME T10]}}}
