\newcommand{\intervalcc}{\tikz[baseline=-0.55ex,x=0.62cm,y=0.62cm]{
  \draw[-Stealth,BN!55](-2,0)--(2,0); \draw[BN,very thick](-1,0)--(1,0);
  \fill[BN](-1,0)circle(2pt) (1,0)circle(2pt);
  \node[below,font=\scriptsize]at(-1,0){$a$};\node[below,font=\scriptsize]at(1,0){$b$};}}
\newcommand{\intervaloo}{\tikz[baseline=-0.55ex,x=0.62cm,y=0.62cm]{
